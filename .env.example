# Variables de entorno del proyecto (desarrollo).
# Para personalizarlas:  cp .env.example .env   y ajustá los valores.
# Este archivo se usa como referencia para Docker Compose (credenciales de DB)
# y para la configuración del backend.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=pedidos

# ── Backend (Express) ───────────────────────────────────────────────────────
# Puerto del servidor Express
PORT=3000

# Entorno: development | production | test
NODE_ENV=development

# Cadena de conexión a PostgreSQL.
# Local (sin Docker): postgres://app:app@localhost:5432/pedidos
# Docker Compose:     postgres://app:app@db:5432/pedidos
DATABASE_URL=postgres://app:app@localhost:5432/pedidos
